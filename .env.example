# Copy to .env.local and fill in. `vercel env pull .env.local` also populates these.

# Postgres connection string (required)
DATABASE_URL=

# OpenAI API key — used by the word AI routes and the realtime voice tutor (required)
OPENAI_API_KEY=

# Voice the tutor speaks with (optional; defaults to "marin")
REALTIME_VOICE=

# OpenAI Realtime model id for the tutor (optional; defaults to "gpt-realtime")
OPENAI_REALTIME_MODEL=
