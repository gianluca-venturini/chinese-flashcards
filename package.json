{
  "name": "chinese-flashcards",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.x",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "bun --env-file=.env.local test",
    "test:integration": "bun --env-file=.env.local test ./src/**/*.integration.ts",
    "db:seed": "bun run scripts/seed-db.ts",
    "env:setup": "bunx vercel link",
    "env:pull": "bunx vercel env pull .env.local",
    "ui:init": "shadcn@latest init -b base -t next -p nova -y",
    "ui:add": "shadcn@latest add card toggle-group toggle badge -y",
    "ui:add:elements": "shadcn@latest add @ai-elements/conversation @ai-elements/message @ai-elements/persona -y"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.67",
    "@base-ui/react": "^1.6.0",
    "@rive-app/react-webgl2": "^4.29.5",
    "@stackframe/stack": "^2.8.48",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@types/lodash": "^4.17.20",
    "ai": "^5.0.93",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lodash": "^4.17.21",
    "lucide-react": "^1.24.0",
    "next": "16.0.8",
    "postgres": "^3.4.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.13.0",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bun": "latest",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.8",
    "fake-indexeddb": "^6.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vercel": "^48.10.2"
  }
}
